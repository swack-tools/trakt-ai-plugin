name = "trakt-mcp"
main = "build/worker/shim.mjs"
compatibility_date = "2026-09-22"
account_id = "${CLOUDFLARE_ACCOUNT_ID}"
workers_dev = false
preview_urls = false

[build]
command = "worker-build --release"

[vars]
PUBLIC_BASE_URL = "${PUBLIC_BASE_URL}"
TRAKT_API_URL = "https://api.trakt.tv"
TRAKT_AUTH_URL = "https://api.trakt.tv"
TRAKT_AUTHORIZE_URL = "https://auth.trakt.tv"

# GitHub Pages is the DNS origin. Only API/auth paths invoke this Worker.
# Trailing wildcards include query strings in Cloudflare route matching.
[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/mcp*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/sse*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/messages*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/health*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/privacy*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/openapi.json*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/.well-known/oauth-authorization-server*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/.well-known/oauth-protected-resource*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/.well-known/openai-apps-challenge*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/login.js*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/login.css*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/oauth/*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/auth/*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/sync/*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/search*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[routes]]
pattern = "${CLOUDFLARE_PLUGIN_DNS}/recommendations*"
zone_name = "${CLOUDFLARE_ZONE_NAME}"

[[durable_objects.bindings]]
name = "TRAKT_COORDINATOR"
class_name = "TraktStore"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["TraktCoordinator"]

# Cloudflare refuses to delete a class while the live Worker still binds it, so
# the old class is deleted by the next migration, once this one has deployed.
[[migrations]]
tag = "v2"
new_sqlite_classes = ["TraktStore"]

[observability]
enabled = true
head_sampling_rate = 1
[observability.logs]
enabled = true
invocation_logs = false
[observability.traces]
enabled = true
head_sampling_rate = 0.1
