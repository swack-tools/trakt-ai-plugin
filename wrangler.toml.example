name = "trakt-mcp"
main = "build/worker/shim.mjs"
compatibility_date = "2026-09-22"
account_id = "${CLOUDFLARE_ACCOUNT_ID}"
workers_dev = false
preview_urls = false

[build]
command = "worker-build --release"

[vars]
TRAKT_API_URL = "https://api.trakt.tv"
TRAKT_AUTH_URL = "https://api.trakt.tv"
TRAKT_REDIRECT_URI = "urn:ietf:wg:oauth:2.0:oob"

# GitHub Pages is the DNS origin. Only API/auth paths invoke this Worker.
# Trailing wildcards include query strings in Cloudflare route matching.
[[routes]]
pattern = "trakt.swacktech.com/mcp*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/sse*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/messages*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/health*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/privacy*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/openapi.json*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/.well-known/oauth-authorization-server*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/.well-known/oauth-protected-resource*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/.well-known/ai-plugin.json*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/logo.svg*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/login.js*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/login.css*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/oauth/*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/auth/*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/sync/*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/search*"
zone_name = "swacktech.com"

[[routes]]
pattern = "trakt.swacktech.com/recommendations*"
zone_name = "swacktech.com"

[[kv_namespaces]]
binding = "TRAKT_SESSIONS"
id = "${CLOUDFLARE_KV_NAMESPACE}"

[[durable_objects.bindings]]
name = "TRAKT_COORDINATOR"
class_name = "TraktCoordinator"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["TraktCoordinator"]

[observability]
enabled = true
head_sampling_rate = 1
[observability.logs]
enabled = true
invocation_logs = false
[observability.traces]
enabled = true
head_sampling_rate = 0.1
